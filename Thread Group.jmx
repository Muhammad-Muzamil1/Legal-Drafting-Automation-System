            &quot;vehicleMake&quot;,&#xd;
            &quot;vehicleModel&quot;,&#xd;
            &quot;vehicleColor&quot;,&#xd;
            &quot;chassisNumber&quot;,&#xd;
            &quot;engineNumber&quot;,&#xd;
            &quot;vehicleHorsePower&quot;,&#xd;
            &quot;weeklyRentAmount&quot;,&#xd;
            &quot;weeklyRentWords&quot;,&#xd;
            &quot;rentPaymentDay&quot;,&#xd;
