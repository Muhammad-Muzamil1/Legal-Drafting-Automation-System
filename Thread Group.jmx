        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="Document-Service" enabled="false">
          <stringProp name="HTTPSampler.domain">localhost</stringProp>
          <stringProp name="HTTPSampler.port">8082</stringProp>
          <stringProp name="HTTPSampler.protocol">http</stringProp>
          <stringProp name="HTTPSampler.path">http://localhost:8082/api/v1/generatepdf</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
          <stringProp name="HTTPSampler.method">POST</stringProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
            <collectionProp name="Arguments.arguments">
              <elementProp name="" elementType="HTTPArgument">
                <boolProp name="HTTPArgument.always_encode">false</boolProp>
                <stringProp name="Argument.value">&lt;!DOCTYPE html&gt;&#xd;
&lt;html&gt;&#xd;
&lt;head&gt;&#xd;
    &lt;meta charset=&quot;UTF-8&quot;&gt;&#xd;
    &lt;title&gt;Agreement of Rent Vehicle&lt;/title&gt;&#xd;
&#xd;
    &lt;style&gt;&#xd;
&#xd;
        @page{&#xd;
            margin-top:120px;&#xd;
            margin-bottom:120px;&#xd;
            margin-left:100px;&#xd;
            margin-right:100px;&#xd;
        }&#xd;
&#xd;
        body{&#xd;
            font-family:&quot;Times New Roman&quot;, serif;&#xd;
            font-size:16px;&#xd;
            line-height:1.7;&#xd;
        }&#xd;
&#xd;
        h1{&#xd;
            text-align:center;&#xd;
            text-decoration:underline;&#xd;
        }&#xd;
&#xd;
        .section{&#xd;
            margin-top:25px;&#xd;
        }&#xd;
&#xd;
        .vehicle-table{&#xd;
            margin-top:20px;&#xd;
        }&#xd;
&#xd;
        .vehicle-table td{&#xd;
            padding:4px 0;&#xd;
        }&#xd;
&#xd;
        .signature-table{&#xd;
            width:100%;&#xd;
            margin-top:40px;&#xd;
        }&#xd;
&#xd;
        .signature-table td{&#xd;
            width:50%;&#xd;
            vertical-align:top;&#xd;
        }&#xd;
&#xd;
        .center{&#xd;
            text-align:center;&#xd;
        }&#xd;
&#xd;
    &lt;/style&gt;&#xd;
&#xd;
&lt;/head&gt;&#xd;
&#xd;
&lt;body&gt;&#xd;
&#xd;
&lt;h1&gt;AGREEMENT OF RENT VEHICLE&lt;/h1&gt;&#xd;
&#xd;
&lt;p&gt;&#xd;
    This agreement of rent vehicle has been made at&#xd;
    &lt;strong&gt;Karachi&lt;/strong&gt;&#xd;
    on this &lt;strong&gt;10&lt;/strong&gt; day of&#xd;
    &lt;strong&gt;March&lt;/strong&gt;.&#xd;
&lt;/p&gt;&#xd;
&#xd;
&lt;div class=&quot;section&quot;&gt;&#xd;
&#xd;
    &lt;h3&gt;BETWEEN&lt;/h3&gt;&#xd;
&#xd;
    &lt;p&gt;&#xd;
        Mr. &lt;strong&gt;Ahmed Ali&lt;/strong&gt;&#xd;
        S/o &lt;strong&gt;Ghulam Mustafa&lt;/strong&gt;,&#xd;
        Muslim, Adult, holding CNIC No.&#xd;
        &lt;strong&gt;42101-5678901-2&lt;/strong&gt;,&#xd;
&#xd;
        Resident of &lt;strong&gt;House 23, Block D, Gulistan-e-Johar, Karachi&lt;/strong&gt;,&#xd;
&#xd;
        hereinafter called the &lt;b&gt;OWNER / FIRST PARTY&lt;/b&gt;.&#xd;
    &lt;/p&gt;&#xd;
&#xd;
&lt;/div&gt;&#xd;
&#xd;
&lt;div class=&quot;section&quot;&gt;&#xd;
&#xd;
    &lt;h3&gt;AND&lt;/h3&gt;&#xd;
&#xd;
    &lt;p&gt;&#xd;
        Mr. &lt;strong&gt;Bilal Hussain&lt;/strong&gt;&#xd;
        S/o &lt;strong&gt;Rashid Hussain&lt;/strong&gt;,&#xd;
        Muslim, Adult, holding CNIC No.&#xd;
        &lt;strong&gt;42101-9988776-3&lt;/strong&gt;,&#xd;
&#xd;
        Resident of &lt;strong&gt;Flat 5, Sector 11-C, North Karachi&lt;/strong&gt;,&#xd;
&#xd;
        hereinafter referred to as the &lt;b&gt;TENANT / SECOND PARTY&lt;/b&gt;.&#xd;
    &lt;/p&gt;&#xd;
&#xd;
&lt;/div&gt;&#xd;
&#xd;
&lt;div class=&quot;section&quot;&gt;&#xd;
&#xd;
    &lt;p&gt;&#xd;
        Whereas the OWNER / FIRST PARTY is the lawful owner&#xd;
        of the following vehicle:&#xd;
    &lt;/p&gt;&#xd;
&#xd;
    &lt;table class=&quot;vehicle-table&quot;&gt;&#xd;
&#xd;
        &lt;tr&gt;&#xd;
            &lt;td&gt;Registration No:&lt;/td&gt;&#xd;
            &lt;td&gt;&lt;strong&gt;KHI-5678&lt;/strong&gt;&lt;/td&gt;&#xd;
        &lt;/tr&gt;&#xd;
&#xd;
        &lt;tr&gt;&#xd;
            &lt;td&gt;Make:&lt;/td&gt;&#xd;
            &lt;td&gt;&lt;strong&gt;Honda&lt;/strong&gt;&lt;/td&gt;&#xd;
        &lt;/tr&gt;&#xd;
&#xd;
        &lt;tr&gt;&#xd;
            &lt;td&gt;Model:&lt;/td&gt;&#xd;
            &lt;td&gt;&lt;strong&gt;Civic 2019&lt;/strong&gt;&lt;/td&gt;&#xd;
        &lt;/tr&gt;&#xd;
&#xd;
        &lt;tr&gt;&#xd;
            &lt;td&gt;Color:&lt;/td&gt;&#xd;
            &lt;td&gt;&lt;strong&gt;Black&lt;/strong&gt;&lt;/td&gt;&#xd;
        &lt;/tr&gt;&#xd;
&#xd;
        &lt;tr&gt;&#xd;
            &lt;td&gt;Chassis No:&lt;/td&gt;&#xd;
            &lt;td&gt;&lt;strong&gt;CHS987654321&lt;/strong&gt;&lt;/td&gt;&#xd;
        &lt;/tr&gt;&#xd;
&#xd;
        &lt;tr&gt;&#xd;
            &lt;td&gt;Engine No:&lt;/td&gt;&#xd;
            &lt;td&gt;&lt;strong&gt;ENG123456789&lt;/strong&gt;&lt;/td&gt;&#xd;
        &lt;/tr&gt;&#xd;
&#xd;
        &lt;tr&gt;&#xd;
            &lt;td&gt;Horse Power:&lt;/td&gt;&#xd;
            &lt;td&gt;&lt;strong&gt;1800cc&lt;/strong&gt;&lt;/td&gt;&#xd;
        &lt;/tr&gt;&#xd;
&#xd;
    &lt;/table&gt;&#xd;
&#xd;
    &lt;p&gt;&#xd;
        Hereinafter referred to as the &lt;b&gt;said vehicle&lt;/b&gt;.&#xd;
    &lt;/p&gt;&#xd;
&#xd;
&lt;/div&gt;&#xd;
&#xd;
&lt;div class=&quot;section&quot;&gt;&#xd;
&#xd;
    &lt;h3 class=&quot;center&quot;&gt;TERMS &amp; CONDITIONS&lt;/h3&gt;&#xd;
&#xd;
    &lt;p&gt;&#xd;
        1. The First Party agrees to rent out the said vehicle to the&#xd;
        Second Party on weekly rent of&#xd;
        Rs. &lt;strong&gt;25000&lt;/strong&gt;&#xd;
        (Rupees &lt;strong&gt;Twenty Five Thousand Pakistani Rupees&lt;/strong&gt; only),&#xd;
        payable every &lt;strong&gt;Every Monday&lt;/strong&gt;.&#xd;
    &lt;/p&gt;&#xd;
&#xd;
    &lt;p&gt;&#xd;
        2. This agreement shall remain valid for a period of&#xd;
        &lt;strong&gt;3 Months&lt;/strong&gt;&#xd;
        and may be extended by mutual consent of both parties.&#xd;
    &lt;/p&gt;&#xd;
&#xd;
    &lt;p&gt;&#xd;
        3. The Owner shall bear the maintenance expenses of the vehicle.&#xd;
        In case of accident or damages, the Tenant shall be responsible&#xd;
        for all repair costs.&#xd;
        If the vehicle is stolen, the Second Party shall be fully responsible.&#xd;
    &lt;/p&gt;&#xd;
&#xd;
    &lt;p&gt;&#xd;
        4. If either party wishes to terminate this agreement,&#xd;
        one month prior notice shall be served to the other party.&#xd;
    &lt;/p&gt;&#xd;
&#xd;
    &lt;p&gt;&#xd;
        5. The Second Party shall return the vehicle in the same condition&#xd;
        as received. Any minor damages shall be the responsibility&#xd;
        of the Second Party.&#xd;
    &lt;/p&gt;&#xd;
&#xd;
    &lt;p&gt;&#xd;
        6. The Owner shall be responsible for all legal matters&#xd;
        related to the vehicle before the date of this agreement,&#xd;
        including police cases, excise matters, ACLC matters,&#xd;
        or court cases.&#xd;
        After the vehicle handover date, the Tenant shall be responsible&#xd;
        for such matters.&#xd;
    &lt;/p&gt;&#xd;
&#xd;
&lt;/div&gt;&#xd;
&#xd;
&lt;div class=&quot;section&quot;&gt;&#xd;
&#xd;
    &lt;p&gt;&#xd;
        IN WITNESS WHEREOF both parties have signed this agreement&#xd;
        on the day, month and year first above mentioned.&#xd;
    &lt;/p&gt;&#xd;
&#xd;
&lt;/div&gt;&#xd;
&#xd;
&lt;br&gt;&#xd;
&#xd;
&lt;table class=&quot;signature-table&quot;&gt;&#xd;
&#xd;
    &lt;tr&gt;&#xd;
&#xd;
        &lt;td&gt;&#xd;
&#xd;
            &lt;b&gt;OWNER / FIRST PARTY&lt;/b&gt;&#xd;
&#xd;
            &lt;br&gt;&lt;br&gt;&#xd;
&#xd;
            Signature: ____________________&#xd;
&#xd;
            &lt;br&gt;&lt;br&gt;&#xd;
&#xd;
            Name: Ahmed Ali&#xd;
&#xd;
            &lt;br&gt;&#xd;
&#xd;
            S/o: Ghulam Mustafa&#xd;
&#xd;
            &lt;br&gt;&#xd;
&#xd;
            CNIC No: 42101-5678901-2&#xd;
&#xd;
        &lt;/td&gt;&#xd;
&#xd;
        &lt;td&gt;&#xd;
&#xd;
            &lt;b&gt;TENANT / SECOND PARTY&lt;/b&gt;&#xd;
&#xd;
            &lt;br&gt;&lt;br&gt;&#xd;
&#xd;
            Signature: ____________________&#xd;
&#xd;
            &lt;br&gt;&lt;br&gt;&#xd;
&#xd;
            Name: Bilal Hussain&#xd;
&#xd;
            &lt;br&gt;&#xd;
&#xd;
            S/o: Rashid Hussain&#xd;
&#xd;
            &lt;br&gt;&#xd;
&#xd;
            CNIC No: 42101-9988776-3&#xd;
&#xd;
        &lt;/td&gt;&#xd;
&#xd;
    &lt;/tr&gt;&#xd;
&#xd;
&lt;/table&gt;&#xd;
&#xd;
&lt;br&gt;&lt;br&gt;&#xd;
&#xd;
&lt;table class=&quot;signature-table&quot;&gt;&#xd;
&#xd;
    &lt;tr&gt;&#xd;
&#xd;
        &lt;td&gt;&#xd;
&#xd;
            &lt;b&gt;Witness 1&lt;/b&gt;&#xd;
&#xd;
            &lt;br&gt;&lt;br&gt;&#xd;
&#xd;
            Signature: ____________________&#xd;
&#xd;
            &lt;br&gt;&#xd;
&#xd;
            Name: Usman Tariq&#xd;
&#xd;
            &lt;br&gt;&#xd;
&#xd;
            S/o: Tariq Mehmood&#xd;
&#xd;
            &lt;br&gt;&#xd;
&#xd;
            CNIC No: 42101-3344556-4&#xd;
&#xd;
        &lt;/td&gt;&#xd;
&#xd;
        &lt;td&gt;&#xd;
&#xd;
            &lt;b&gt;Witness 2&lt;/b&gt;&#xd;
&#xd;
            &lt;br&gt;&lt;br&gt;&#xd;
&#xd;
            Signature: ____________________&#xd;
&#xd;
            &lt;br&gt;&#xd;
&#xd;
            Name: Saif Khan&#xd;
&#xd;
            &lt;br&gt;&#xd;
&#xd;
            S/o: Imran Khan&#xd;
&#xd;
            &lt;br&gt;&#xd;
&#xd;
            CNIC No: 42101-7788990-5&#xd;
&#xd;
        &lt;/td&gt;&#xd;
&#xd;
    &lt;/tr&gt;&#xd;
&#xd;
&lt;/table&gt;&#xd;
&#xd;
&lt;/body&gt;&#xd;
&lt;/html&gt;</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
              </elementProp>
            </collectionProp>
          </elementProp>
