&#xd;
      &quot;witness1Name&quot;: &quot;Usman Tariq&quot;,&#xd;
      &quot;witness1Father&quot;: &quot;Tariq Mehmood&quot;,&#xd;
      &quot;witness1Cnic&quot;: &quot;42101-3344556-4&quot;,&#xd;
&#xd;
      &quot;witness2Name&quot;: &quot;Saif Khan&quot;,&#xd;
      &quot;witness2Father&quot;: &quot;Imran Khan&quot;,&#xd;
      &quot;witness2Cnic&quot;: &quot;42101-7788990-5&quot;&#xd;
    }&#xd;
  }&#xd;
</stringProp>
