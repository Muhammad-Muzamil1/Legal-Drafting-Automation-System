            &quot;ownerName&quot;,&#xd;
            &quot;ownerFatherName&quot;,&#xd;
            &quot;ownerCnic&quot;,&#xd;
            &quot;tenantName&quot;,&#xd;
            &quot;tenantFatherName&quot;,&#xd;
